# ─── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://tesla:tesla_dev@localhost:5432/tesla_sandbox"

# ─── App ───────────────────────────────────────────────────
APP_URL="http://localhost:3000"

# ─── Broker ────────────────────────────────────────────────
# Only "sandbox" is implemented. Live adapters (alpaca, drivewealth) are stubs
# that refuse to start until a licensed integration is completed server-side.
BROKER_MODE="sandbox"

# ─── Initial administrator setup ───────────────────────────
# One-time token required by /admin/setup to create the first super admin.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The setup page is permanently disabled once a super admin exists.
ADMIN_SETUP_TOKEN=""

# Optional: create the first super admin from the CLI instead (npm run admin:create).
# Never commit real values. Password must be at least 12 characters.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ─── Sandbox mailbox ───────────────────────────────────────
# Outgoing email (verification, password reset) is written to the database and
# viewable at /dev/mailbox. Set to "false" in production once SMTP is wired up.
SANDBOX_MAILBOX="true"

# Server-side secrets for a future licensed broker integration (never NEXT_PUBLIC_).
# ALPACA_BROKER_KEY_ID=""
# ALPACA_BROKER_SECRET=""
