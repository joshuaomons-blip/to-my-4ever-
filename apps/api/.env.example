# ---------------------------------------------------------------------------
# Aureon Capital API — environment template. Copy to .env for local dev.
# NEVER commit real values. In cloud environments inject from a secret manager.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://aureon:aureon@localhost:5432/aureon_dev
REDIS_URL=redis://localhost:6379

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production: fetch from KMS/Secrets Manager; rotate with re-encryption job.
APP_ENCRYPTION_KEY=

# Browser origins allowed by CORS (customer web app and admin console).
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
COOKIE_SECURE=false
TRUST_PROXY_HOPS=1

# --- Operating mode -------------------------------------------------------
# sandbox: simulated partner, payments, KYC and prices. No real money.
# live:    refused unless every provider is non-sandbox, every launch gate has two approvals,
#          and LIVE_OPERATIONS_ACKNOWLEDGEMENT is set to the exact phrase in src/config/config.ts.
OPERATING_MODE=sandbox
LIVE_OPERATIONS_ACKNOWLEDGEMENT=

# --- Providers ------------------------------------------------------------
BROKER_PROVIDER=sandbox            # sandbox | alpaca
MARKET_DATA_PROVIDER=sandbox
PAYMENT_PROVIDER=sandbox
KYC_PROVIDER=sandbox

# Alpaca Broker API (only when BROKER_PROVIDER=alpaca). Sandbox keys from the Alpaca broker dashboard.
ALPACA_BROKER_BASE_URL=https://broker-api.sandbox.alpaca.markets
ALPACA_BROKER_API_KEY=
ALPACA_BROKER_API_SECRET=
ALPACA_FIRM_ACCOUNT_ID=

# Webhook signing secrets (>= 16 chars).
SANDBOX_PAYMENT_WEBHOOK_SECRET=
SANDBOX_BROKER_WEBHOOK_SECRET=

# --- Risk & session policy ------------------------------------------------
QUOTE_STALE_AFTER_SECONDS=60
WITHDRAWAL_REVIEW_THRESHOLD_MINOR=100000   # 1,000.00 — withdrawals at/above need staff review
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
STAFF_SESSION_IDLE_MINUTES=15
STAFF_SESSION_ABSOLUTE_HOURS=8
STEP_UP_WINDOW_SECONDS=300

# --- Development only -----------------------------------------------------
EXPOSE_DEV_MAILBOX=true            # exposes /v1/dev/* (refused in production/live)
RUN_WORKER_IN_PROCESS=true         # run job worker inside the API process
BOOTSTRAP_ADMIN_EMAIL=admin@aureon.local
BOOTSTRAP_ADMIN_PASSWORD=
LOG_LEVEL=info
